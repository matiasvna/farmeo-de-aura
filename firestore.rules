rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo permitir modificar usuarios con valores enteros de total_aura
    match /users/{userId} {
      allow read: if true;
      allow update: if request.resource.data.total_aura is int;
      allow create: if true;
      allow delete: if false;
    }

    // Solo permitir registrar logs desde el formulario con esquema válido
    match /aura_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.cantidad is int
                    && request.resource.data.tipo in ['suma', 'resta']
                    && request.resource.data.target_id is string
                    && request.resource.data.evaluator_id is string;
      allow update: if request.resource.data.revisado is bool;
      allow delete: if true;
    }
  }
}
