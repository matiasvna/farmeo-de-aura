rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección 'users'
    match /users/{userId} {
      // Permitir lectura a todos (para el ranking en tiempo real)
      allow read: if true;
      
      // Permitir creación y actualización de puntos de aura
      allow create, update: if true;
      
      // Bloquear eliminación de participantes
      allow delete: if false;
    }

    // Reglas para la colección 'aura_logs'
    match /aura_logs/{logId} {
      // Permitir lectura a todos (para historial y tribunal)
      allow read: if true;
      
      // Permitir registrar nuevos eventos de suma/resta
      allow create: if request.resource.data.cantidad is number
                    && request.resource.data.tipo in ['suma', 'resta']
                    && request.resource.data.target_user is string
                    && request.resource.data.evaluator is string;
      
      // Permitir actualizar para el veredicto de apelación del Tribunal
      allow update: if request.resource.data.revisado is bool;
      
      // Prohibir borrar registros del historial
      allow delete: if false;
    }
  }
}
